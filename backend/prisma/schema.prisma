// Firebase manages credentials. SQL migrations add CHECKs and the active-owner index.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebaseUid String    @unique @map("firebase_uid")
  name        String
  email       String?   @unique
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships         Membership[]
  sentInvitations     Invitation[] @relation("InvitationSender")
  receivedInvitations Invitation[] @relation("InvitationRecipient")
  createdTasks        Task[]       @relation("TaskCreator")

  @@map("users")
}

model Workspace {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  joinCode         String   @unique @map("join_code")
  joinPasswordHash String   @map("join_password_hash")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships  Membership[]
  invitations  Invitation[]
  tasks        Task[]
  activityLogs ActivityLog[]

  @@map("workspaces")
}

model Membership {
  userId      String    @map("user_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  role        String    @default("MEMBER")
  joinedAt    DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt      DateTime? @map("left_at") @db.Timestamptz(6)
  isBanned    Boolean   @default(false) @map("is_banned")

  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignedTasks Task[]    @relation("TaskAssignee")

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Invitation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  inviteeId   String   @map("invitee_id") @db.Uuid
  inviterId   String   @map("inviter_id") @db.Uuid
  status      String   @default("PENDING")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL '3 days')")) @map("expires_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invitee   User      @relation("InvitationRecipient", fields: [inviteeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inviter   User      @relation("InvitationSender", fields: [inviterId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  // Sending must serialize per workspace/recipient to prevent concurrent live invitations.
  @@index([workspaceId, inviteeId, status, expiresAt])
  @@index([inviteeId])
  @@index([inviterId])
  @@map("invitations")
}

model Task {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  priority    String    @default("MEDIUM")
  createdBy   String    @map("created_by") @db.Uuid
  assigneeId  String?   @map("assignee_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  status      String    @default("TODO")
  position    Int
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  dueAt       DateTime? @map("due_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator   User        @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  // MATCH SIMPLE permits an unassigned task; backend checks active membership.
  assignee  Membership? @relation("TaskAssignee", fields: [assigneeId, workspaceId], references: [userId, workspaceId], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId, status, position, id])
  @@index([assigneeId, workspaceId])
  @@index([createdBy])
  @@map("tasks")
}

model ActivityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  content     String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("activity_logs")
}
