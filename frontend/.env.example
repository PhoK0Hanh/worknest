# Copy to .env.local when connecting the Express backend.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Firebase Web configuration only; never place Firebase Admin private keys here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional Socket.IO origin. Defaults to the origin of NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
